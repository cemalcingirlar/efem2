# =========================================
# efemiletisim.com — sunucu tarafı ortam değişkenleri
# =========================================
# Bu dosya ŞABLONDUR; gerçek değerler buraya YAZILMAZ.
# Değerler Vercel → Project → Settings → Environment Variables altına girilir.
# Yerel denemede `.env.local` kullanın (git'e gitmez, bkz. .gitignore).
#
# Kurulum adımları: docs/IYZICO-ENTEGRASYON.md

# ─── iyzico ───────────────────────────────
# Merchant panel → Ayarlar → API Anahtarları
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# sandbox | production  (varsayılan: sandbox)
IYZICO_MODE=sandbox

# Boş bırakılırsa mode'a göre otomatik seçilir:
#   sandbox    → https://sandbox-api.iyzipay.com
#   production → https://api.iyzipay.com
IYZICO_BASE_URL=

# Gösterilecek taksit seçenekleri (virgülle). Varsayılan: 1 (tek çekim).
# Taksit açmadan önce hem merchant hesabında tanımlı olduğunu hem de
# BDDK'nın ürün kategorisi için izin verdiğini doğrulayın.
IYZICO_ENABLED_INSTALLMENTS=1

# ─── Site ─────────────────────────────────
# callback/webhook adresleri bu adresten türetilir; sonunda / olmamalı.
SITE_BASE_URL=https://efemiletisim.com

# Misafir siparişlerinin sonuç sayfasını okuyabilmesi için kullanılan
# HMAC anahtarı. Rastgele en az 32 karakter üretin (ör. `openssl rand -hex 32`).
# Tanımlanmazsa iyzico secret key'inden türetilir.
ORDER_TOKEN_SECRET=

# ─── Firebase Admin (sipariş defteri) ─────
# Firebase Console → Proje Ayarları → Servis Hesapları → Yeni özel anahtar üret.
# İndirilen JSON'un TAMAMI tek satır olarak (veya base64 hâli) yapıştırılır.
FIREBASE_SERVICE_ACCOUNT=
