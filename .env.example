# =========================================
# efemiletisim.com — sunucu tarafı ortam değişkenleri
# =========================================
# Bu dosya ŞABLONDUR; gerçek değerler buraya YAZILMAZ.
# Değerler Vercel → Project → Settings → Environment Variables altına girilir.
# Yerel denemede `.env.local` kullanın (git'e gitmez, bkz. .gitignore).
#
# Kurulum adımları: docs/PAYTR-ENTEGRASYON.md

# ─── PayTR ────────────────────────────────
# PayTR Mağaza Paneli → Bilgi → API Entegrasyon Bilgileri
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Test modu. VARSAYILAN 1 (test): gerçek para çekilmez.
# Canlıya geçerken bilinçli olarak 0 yapın.
PAYTR_TEST_MODE=1

# PayTR'ye eksik/yanlış alan gönderildiğinde ayrıntılı hata mesajı almak için 1.
# Entegrasyon/test aşamasında 1, canlıda 0 önerilir.
PAYTR_DEBUG_ON=0

# Taksit. 0 = taksit AÇIK, 1 = kapalı. Kodun kendi varsayılanı kapalıdır;
# yani bu değişken tanımlı değilse taksit görünmez ("fail closed").
#
# PAYTR_MAX_INSTALLMENT en fazla kaç taksit sunulacağını söyler (1-12; 0 = sınır yok).
# Bu iki değeri /api/payment/config sayfalara da bildirir: ürün, sepet ve ödeme
# sayfasındaki taksit tablosu (js/paytr-installments.js) buradan okur. Dolayısıyla
# vitrinde gösterilen taksit ile ödeme ekranındaki taksit her zaman aynıdır;
# ikinci bir yeri elle güncellemek gerekmez.
#
# Uyarı: elektronik/telekomünikasyon ürünlerinde BDDK taksit kısıtları vardır ve
# kategoriye göre değişir. Aşağıdaki 12 değeri mağaza sahibinin kendi kategorisi
# için doğruladığı sınırdır; kategori değişirse yeniden doğrulanmalıdır.
# Taksidin ayrıca PayTR mağaza panelinde de tanımlı olması gerekir.
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=12

# ─── Site ─────────────────────────────────
# merchant_ok_url / merchant_fail_url bu adresten türetilir; sonunda / olmamalı.
SITE_BASE_URL=https://efemiletisim.com

# Misafir siparişlerinin sonuç sayfasını okuyabilmesi için kullanılan
# HMAC anahtarı. Rastgele en az 32 karakter üretin (ör. `openssl rand -hex 32`).
# Tanımlanmazsa PayTR merchant key'inden türetilir.
ORDER_TOKEN_SECRET=

# ─── Yönetici erişimi ─────────────────────
# admin.html'in TAMAMI (sipariş, ürün, kupon, görsel yükleme) bu listeyle
# korunur. Panele Firebase hesabıyla giriş yapan kişinin DOĞRULANMIŞ
# e-postası bu listede olmalıdır. Virgülle birden fazla adres yazılabilir.
# Liste boşsa yönetici API'lerinin tamamı kapalıdır (fail closed).
ADMIN_EMAILS=destek@efemiletisim.com

# ─── Firebase Admin (sipariş defteri + katalog + kuponlar) ─────
# Firebase Console → Proje Ayarları → Servis Hesapları → Yeni özel anahtar üret.
# İndirilen JSON'un TAMAMI tek satır olarak (veya base64 hâli) yapıştırılır.
FIREBASE_SERVICE_ACCOUNT=

# ─── Firebase Storage (ürün görselleri) ───
# Panelden yüklenen görsellerin gideceği kova. Boş bırakılırsa
# "<project_id>.firebasestorage.app" varsayılır.
# Firebase Console → Storage → kova adı.
FIREBASE_STORAGE_BUCKET=
